# ============================================================
# SECRETS & CREDENTIALS  (NEVER commit these)
# ============================================================
.env
*.env

# Google OAuth credential files (download from Cloud Console)
src/credentials/*.json

# Blogger OAuth token pickle files (generated by generate_token.py)
src/credentials/tokens/
*.pkl

# Tumblr OAuth token files
tumblr_token*.json
src/credentials/tokens/tumblr_token*.json

# Any stray credential/token files at root
credentials*.json
client_secret*.json
token*.json

# ============================================================
# GENERATED RUNTIME DATA  (machine-specific, regenerated each run)
# ============================================================

# Main article database (reset per deployment)
data/database/articles.csv
data/database/used_titles.csv
data/database/scraped_articles.json
data/database/stats.json

# All generated output (images, article JSONs, brand outputs, social exports)
data/output/

# Vector store data
data/vector_store/

# Raw scraped competitor data (large, regenerated by scraper)
data/bucketlistt_knowledge.json
data/competitor_keywords_raw.json

# ============================================================
# PYTHON
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python

